# ---- Server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
DB_PATH=./data/reelscout.db
CORS_ORIGIN=http://localhost:5173

# ---- Image brain (Google AI Studio, free tier) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Video sources ----
APIFY_TOKEN=
RAPIDAPI_KEY=
RAPIDAPI_IG_HOST=
ENABLE_TIKTOK=true

# ---- Pipeline tuning ----
MIN_PER_SOURCE=20
MATCH_THRESHOLD_SHOW=50
MATCH_THRESHOLD_EXACT=70
SOURCE_TIMEOUT_MS=120000
MAX_CONCURRENT_SEARCHES=2

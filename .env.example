# ---- Server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
DB_PATH=./data/reelscout.db
CORS_ORIGIN=http://localhost:5173

# ---- Image brain (Google AI Studio, free tier) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Video sources ----
APIFY_TOKEN=
RAPIDAPI_KEY=
RAPIDAPI_IG_HOST=
ENABLE_TIKTOK=true

# ---- Pipeline tuning ----
MIN_PER_SOURCE=20
MATCH_THRESHOLD_SHOW=50
MATCH_THRESHOLD_EXACT=70
SOURCE_TIMEOUT_MS=120000
MAX_CONCURRENT_SEARCHES=2

# ---- Image brain tuning ----
GEMINI_RPM=5                 # free tier: 5 requests/minute per model
GEMINI_MAX_VERIFY=40         # max candidates per source batch sent to Gemini (rest: CLIP + caption)
VERIFY_BUDGET_MS=90000       # time budget for the vision check per batch
CLIP_MODEL=Xenova/clip-vit-base-patch32

# ---- Collector tuning (Apify actor IDs are swappable) ----
APIFY_IG_ACTOR=apify/instagram-hashtag-scraper
APIFY_IG_FALLBACK_ACTOR=apify/instagram-scraper
APIFY_META_ACTOR=curious_coder/facebook-ads-library-scraper
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
META_COUNTRY=ALL             # ALL or a 2-letter code like IN, US
META_USE_BROWSER_FIRST=true  # free Playwright scraper first, Apify as fallback
RAW_CACHE_HOURS=24           # cache raw source responses (saves free credits)
